import { readFileSync, writeFileSync } from "node:fs";

/**
 * Turn the owner's "BB vs SB Limp" sheet into a dataset we can ship.
 *
 *   npx vite-node scripts/generateLimpDefenceRanges.mts -- --json=<exported page json>
 *
 * Three grids, one legend each, so nothing here is inferred from colour alone.
 * The bands are the sheet's own - 15-20BB, 20-25BB and 30BB+ - and the actions
 * are what its legends name.
 *
 * The point of the sheet is that the iso-raise barely moves with depth (36.9,
 * 34.5, 38.5 percent) while what it is made of changes completely: at 15-20BB
 * over half of it is a shove, and by 30BB the shove is gone and the same width is
 * raises with a plan for the four-bet. A model with one iso range per seat gets
 * the width right and the strategy wrong.
 *
 * Run against the export produced before the source images left the disk; the
 * generated file is the surviving record, so regenerating needs the charts back.
 */

interface Cluster { hex: string; hands: string[] }

/** Legend per grid, read off the sheet. Same colour can mean different things. */
const BANDS: ReadonlyArray<{
  fromBucket: number;
  label: string;
  jam?: string;
  iso: readonly string[];
  check: string;
}> = [
  { fromBucket: 15, label: "15-20bb", jam: "#D87878", iso: ["#FFC060", "#903018"], check: "#90A890" },
  { fromBucket: 20, label: "20-25bb", jam: "#D87878", iso: ["#FFC060", "#903018"], check: "#90A890" },
  { fromBucket: 30, label: "30bb+", iso: ["#FFC060", "#903018", "#601860", "#C078A8"], check: "#90A890" },
];

const jsonFlag = process.argv.find((item) => item.startsWith("--json="));
const jsonPath = jsonFlag === undefined ? "" : jsonFlag.slice("--json=".length);
if (jsonPath === "") throw new Error("--json=<file> must point at the exported 'BB vs SB ranges' page");

const outFlag = process.argv.find((item) => item.startsWith("--out="));
const outPath = outFlag === undefined ? "src/data/ranges/limpDefenceRanges.generated.ts" : outFlag.slice("--out=".length);

const raw = readFileSync(jsonPath, "utf8").replace(/^﻿/, "");
const parsed = JSON.parse(raw) as { page: string; grids: Array<{ clusters: Cluster[] | { value: Cluster[] } }> };
if (parsed.grids.length !== BANDS.length) {
  throw new Error(`expected ${BANDS.length} grids for the three depth bands, found ${parsed.grids.length}`);
}

const COMBOS = (hand: string) => (hand.length === 2 ? 6 : hand.endsWith("s") ? 4 : 12);
const width = (hands: readonly string[]) => hands.reduce((sum, hand) => sum + COMBOS(hand), 0) / 1326 * 100;

const rows = BANDS.map((band, index) => {
  const source = parsed.grids[index].clusters;
  const clusters = Array.isArray(source) ? source : source.value;
  const cells = clusters.reduce((sum, cluster) => sum + cluster.hands.length, 0);
  if (cells !== 169) throw new Error(`${band.label}: ${cells} cells, expected 169`);

  const pick = (hex: string) => clusters.find((cluster) => cluster.hex === hex)?.hands ?? [];
  const jam = band.jam === undefined ? [] : pick(band.jam);
  const iso = band.iso.flatMap(pick);
  const check = pick(band.check);

  // Every cell has to land in exactly one action, or the legend was read wrong.
  const claimed = jam.length + iso.length + check.length;
  const unknown = clusters
    .filter((cluster) => cluster.hex !== band.jam && !band.iso.includes(cluster.hex) && cluster.hex !== band.check)
    .map((cluster) => `${cluster.hex} x${cluster.hands.length}`);
  if (unknown.length > 0) throw new Error(`${band.label}: colours not in the legend - ${unknown.join(", ")}`);
  if (claimed !== 169) throw new Error(`${band.label}: legend covers ${claimed} of 169 cells`);

  return { ...band, jam: jam.sort(), iso: iso.sort(), check: check.sort() };
});

const lines: string[] = [];
lines.push("// GENERATED by scripts/generateLimpDefenceRanges.mts - do not edit by hand.");
lines.push("//");
lines.push("// The big blind against a small-blind limp, measured from the owner's chart.");
lines.push("// Bands are the sheet's own and each grid carries its own legend. The width of");
lines.push("// the raise hardly moves with depth; what it is made of does - at 15-20BB more");
lines.push("// than half of it is a shove, and by 30BB there is no shove at all.");
lines.push("");
lines.push("export interface LimpDefenceBand {");
lines.push("  /** Lowest stack bucket this band covers. */");
lines.push("  readonly fromBucket: number;");
lines.push("  /** The sheet's own name for the band. */");
lines.push("  readonly label: string;");
lines.push("  /** Shove over the limp. Empty from 30BB up, where the sheet draws none. */");
lines.push("  readonly jam: readonly string[];");
lines.push("  /** Raise to 3.5x, whatever the sheet's plan for the follow-up. */");
lines.push("  readonly iso: readonly string[];");
lines.push("  /** Check the option. */");
lines.push("  readonly check: readonly string[];");
lines.push("}");
lines.push("");
lines.push("export const BB_VS_SB_LIMP: readonly LimpDefenceBand[] = [");
for (const row of rows) {
  lines.push("  {");
  lines.push(`    fromBucket: ${row.fromBucket}, label: ${JSON.stringify(row.label)},`);
  lines.push(`    jam: ${JSON.stringify(row.jam)},`);
  lines.push(`    iso: ${JSON.stringify(row.iso)},`);
  lines.push(`    check: ${JSON.stringify(row.check)},`);
  lines.push("  },");
}
lines.push("];");
lines.push("");
writeFileSync(outPath, lines.join("\n"), "utf8");

console.log(`written: ${outPath}`);
console.log("");
console.log("band      jam     iso    check    acts");
for (const row of rows) {
  console.log(
    row.label.padEnd(10) +
    `${width(row.jam).toFixed(1)}%`.padStart(6) +
    `${width(row.iso).toFixed(1)}%`.padStart(8) +
    `${width(row.check).toFixed(1)}%`.padStart(8) +
    `${(width(row.jam) + width(row.iso)).toFixed(1)}%`.padStart(9),
  );
}
