import { mkdirSync, writeFileSync } from "node:fs";
import { dirname } from "node:path";
import { compareHeroRanges } from "./lib/postflopHeroRangeConsistency.mts";

/**
 * Families whose solve put the hero on a narrower range than the product teaches.
 *
 * The trainer deals the hero only from the solved range, so when that range is
 * narrower than the opening range the preflop packs teach, a player is practising
 * a hand distribution they will never actually hold - and the strategy attached
 * to it was computed for the narrower, stronger range.
 *
 * Six shipped rules are in this state, all six button families: solved against 13
 * to 19 percent where the pack now opens 43.9. They are two entire pilots, BTN vs
 * BB c-bet and facing-bet, so withholding them would take the most common spot in
 * the game out of the beta. Saying so is the proportionate answer, and it clears
 * itself when those families are re-solved.
 *
 * Only families the guard could actually compare appear here. One it cannot -
 * the 80BB button family, whose depth the preflop pack does not cover - is
 * deliberately absent rather than guessed at, and the guard reports it separately.
 *
 *   npm run mtt:postflop-range-gap -- --write
 */

const OUTPUT = "src/data/ranges/postflopRangeGap.generated.ts";

/**
 * Below this the two are the same range described slightly differently, which is
 * not worth a caveat. The cutoff sits at 2.1 points and the small blind at 6.0;
 * the button families sit above 20.
 */
export const MATERIAL_GAP_POINTS = 10;

function render(rows: ReturnType<typeof compareHeroRanges>): string {
  const material = rows
    .filter((row) => row.gapPoints !== null && row.gapPoints >= MATERIAL_GAP_POINTS)
    .sort((left, right) => left.familyId.localeCompare(right.familyId, "en"));

  const body = material.map((row) => [
    `  ${row.familyId}: {`,
    `    solvedPct: ${row.solvePct},`,
    `    taughtPct: ${row.packPct},`,
    `  },`,
  ].join("\n")).join("\n");

  return `// Generated by \`npm run mtt:postflop-range-gap -- --write\`. Do not edit.
//
// Families solved against a materially narrower hero range than the preflop packs
// teach for that seat and depth. The trainer deals the hero only from the solved
// range, so these are spots where a player practises a hand distribution they
// will not actually hold.
//
// A family absent from this table either matches what is taught, or could not be
// compared - see \`npm run mtt:postflop-range-consistency\`, which reports both.

export interface HeroRangeGap {
  /** Width of the range the family was solved against, as a percentage of all hands. */
  solvedPct: number;
  /** Width of the opening range the preflop packs teach for that seat and depth. */
  taughtPct: number;
}

export const MTT_POSTFLOP_HERO_RANGE_GAP: Readonly<Record<string, HeroRangeGap>> = {
${body}
};

/** The gap for a rule's family, or undefined when there is none worth stating. */
export function heroRangeGapForFamily(familyId: string): HeroRangeGap | undefined {
  return MTT_POSTFLOP_HERO_RANGE_GAP[familyId];
}
`;
}

const write = process.argv.includes("--write");
const rows = compareHeroRanges();
const material = rows.filter((row) => row.gapPoints !== null && row.gapPoints >= MATERIAL_GAP_POINTS);

if (write) {
  mkdirSync(dirname(OUTPUT), { recursive: true });
  writeFileSync(OUTPUT, render(rows), "utf8");
}

console.log("MTT postflop hero range gap");
console.log(`mode: ${write ? "WRITE" : "DRY_RUN"}`);
console.log(`threshold: ${MATERIAL_GAP_POINTS} percentage points`);
console.log(`families compared: ${rows.filter((row) => row.gapPoints !== null).length}`);
console.log(`families with a material gap: ${material.length}`);
for (const row of material) {
  console.log(`  ${row.familyId}: solved ${row.solvePct}% vs taught ${row.packPct}%`);
}
if (write) console.log(`written: ${OUTPUT}`);
