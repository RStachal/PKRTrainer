import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";

/**
 * Extract the hero preflop range weights each pilot family was solved against.
 *
 * TexasSolver range strings accept a `hand:weight` form, and three families use
 * it: the button opens 55 and 66 a quarter of the time, T9s three quarters, and
 * so on. The trainer deals the hero uniformly from the solved range, so without
 * these weights a hand the button opens 25 percent of the time is practised four
 * times more often than the solve assumes.
 *
 * Measured before this existed, on MTT9_50BB_BTN_BB_SRP: 39 of 50 shipped hand
 * classes were opened part-time, and the range as a whole was dealt 1.44x too
 * often relative to the solve. The cutoff family, whose range carries no weights,
 * measured exactly 1.00x - which is what made the button's number look like a
 * narrow range rather than a weighted one.
 *
 * Emitted as a generated table rather than plumbed through the draft pipeline,
 * for the same reason `postflopSolvedSpr` and `postflopTreeIntegrity` are: it is
 * data recovered from the solve inputs, it needs no pack rebuild, and a test
 * reconciles it against the parameter files on every run.
 *
 *   npm run mtt:postflop-range-weights -- --write
 */

const PARAM_ROOT = "Agents/solver-input/texas-solver/mtt-safe-flops-v1/parameters";
const OUTPUT = "src/data/ranges/postflopRangeWeights.generated.ts";
const PARAM_FILE = /^\d+_(?<family>[A-Z0-9_]+?)_[AKQJT98765432]{3}(?:r|tt|mono)\.txt$/;

/**
 * Which side of the solve the hero sits on.
 *
 * Families are named for the hero first, and the ones that put the hero out of
 * position say so. Everything else has the hero as the preflop raiser in
 * position, which is `set_range_ip`.
 */
export function heroRangeKey(familyId: string): "set_range_ip" | "set_range_oop" {
  return familyId.includes("_OOP") ? "set_range_oop" : "set_range_ip";
}

export function parseRangeWeights(line: string): Map<string, number> {
  const weights = new Map<string, number>();
  for (const entry of line.split(",")) {
    const [hand, rawWeight] = entry.trim().split(":");
    if (!hand) continue;
    const weight = rawWeight === undefined ? 1 : Number(rawWeight);
    weights.set(hand, Number.isFinite(weight) && weight >= 0 && weight <= 1 ? weight : 1);
  }
  return weights;
}

/** Hero weights below 1 per family, keyed by family id. Families with a pure range are omitted. */
export function collectRangeWeights(paramRoot = PARAM_ROOT): Map<string, Map<string, number>> {
  const found = new Map<string, Map<string, number>>();
  if (!existsSync(paramRoot)) return found;

  for (const set of readdirSync(paramRoot, { withFileTypes: true }).filter((entry) => entry.isDirectory())) {
    const dir = join(paramRoot, set.name);
    for (const file of readdirSync(dir)) {
      const match = PARAM_FILE.exec(file);
      if (match?.groups === undefined) continue;
      const family = match.groups.family;
      if (found.has(family)) continue;

      const key = heroRangeKey(family);
      const line = readFileSync(join(dir, file), "utf8")
        .split(/\r?\n/)
        .find((item) => item.startsWith(`${key} `));
      if (line === undefined) continue;

      const weights = parseRangeWeights(line.slice(key.length + 1));
      const partial = [...weights].filter(([, weight]) => weight < 1);
      // A pure range needs no entry: absent means every class is dealt in full,
      // which is what the uniform deal already does.
      if (partial.length > 0) found.set(family, new Map(partial));
    }
  }
  return found;
}

function render(weights: Map<string, Map<string, number>>): string {
  const families = [...weights].sort(([left], [right]) => left.localeCompare(right, "en"));
  const body = families.map(([family, classes]) => {
    const entries = [...classes]
      .sort(([left], [right]) => left.localeCompare(right, "en"))
      .map(([hand, weight]) => `    ${JSON.stringify(hand)}: ${weight},`)
      .join("\n");
    return `  ${family}: {\n${entries}\n  },`;
  }).join("\n");

  return `// Generated by \`npm run mtt:postflop-range-weights -- --write\`. Do not edit.
//
// How often the hero's preflop range actually opens each hand class, for the
// families whose solve inputs use TexasSolver's \`hand:weight\` form. A class not
// listed here is opened in full.
//
// Without this the trainer deals uniformly from the solved range, so a hand the
// button opens a quarter of the time is practised four times too often. The
// advice shown for it stays correct; the distribution the player drills does not.

export const MTT_POSTFLOP_HERO_RANGE_WEIGHTS: Readonly<Record<string, Readonly<Record<string, number>>>> = {
${body}
};

/** How often this family's hero range opens a class. Unlisted classes open in full. */
export function heroRangeWeight(familyId: string, handClass: string): number {
  return MTT_POSTFLOP_HERO_RANGE_WEIGHTS[familyId]?.[handClass] ?? 1;
}
`;
}

const write = process.argv.includes("--write");
const weights = collectRangeWeights();
const rendered = render(weights);

if (write) {
  mkdirSync(dirname(OUTPUT), { recursive: true });
  writeFileSync(OUTPUT, rendered, "utf8");
}

const totalClasses = [...weights.values()].reduce((sum, classes) => sum + classes.size, 0);
console.log("MTT postflop hero range weights");
console.log(`mode: ${write ? "WRITE" : "DRY_RUN"}`);
console.log(`families with a weighted hero range: ${weights.size}`);
console.log(`hand classes carrying a weight below 1: ${totalClasses}`);
for (const [family, classes] of [...weights].sort()) {
  console.log(`  ${family}: ${classes.size} class(es)`);
}
if (write) console.log(`written: ${OUTPUT}`);
