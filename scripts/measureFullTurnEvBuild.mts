import { copyFileSync, existsSync, mkdirSync, readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs";
import { join } from "node:path";

/**
 * Přežije build knihovnu o 75 MB, když do ní přibude turnová EV?
 *
 *   npm run mtt:turn-ev-build-probe            # nastaví atrapy
 *   npm run mtt:turn-ev-build-probe -- --clean # uklidí je
 *
 * ## Proč to musí vzniknout dřív než ta data
 *
 * Majitel 10. 9. 2026 zvolil dodat EV **všem 48 rodinám**. Stavba je osm a půl
 * hodiny jednoho jádra, takže se vyplatí vědět předem, jestli výsledek vůbec
 * projde buildem - a to nikdo neví. Hlavička `checkBundleBudget` varuje doslova:
 * „halda buildu je na 8 GB a při 53 MB knihovny prošla; při 64 MB to nikdo
 * neměřil, takže první pád buildu na paměti je očekávatelný jev, ne záhada."
 * Turnová EV přidá 21 MB raw, tedy na 75 MB.
 *
 * ## Proč atrapy, a co to o výsledku říká a neříká
 *
 * Na haldu buildu a na `tsc --noEmit` nemá vliv **obsah** tabulek, ale jejich
 * počet, velikost a to, že je `resolveJsonModule` čte všechny. Atrapa je proto
 * **kopie skutečné tabulky** pod cizím jménem - ne vymyšlený soubor. Tvar,
 * velikost i stlačitelnost jsou tedy pravé.
 *
 * **Co to neříká:** nic o správnosti dat. Atrapy nesou EV jiné rodiny, takže se
 * nesmí dostat k hráči - runtime by je odmítl na otisku packu, ale spoléhat na
 * to by bylo hloupé. Proto je tenhle skript umí zase sundat a proto to říká
 * nahlas v každém výpisu.
 */

const OUT_DIR = "src/data/ranges/turn-ev";
const PACK_DIR = "src/data/ranges/turn";
const MANIFEST_PATH = "src/data/ranges/turnEvManifest.generated.ts";
const MARKER = join(OUT_DIR, "PROBE-ATRAPY.txt");

const clean = process.argv.includes("--clean");

interface ManifestRow { familyId: string; packId: string; slug: string }

/** Tabulky, které v adresáři opravdu leží, i s tím, ke kterému packu patří. */
function survivors(): ManifestRow[] {
  if (!existsSync(OUT_DIR)) return [];
  return readdirSync(OUT_DIR)
    .filter((name) => name.endsWith(".generated.json"))
    .map((name) => {
      const table = JSON.parse(readFileSync(join(OUT_DIR, name), "utf8")) as {
        familyId?: string; packId?: string;
      };
      return {
        familyId: table.familyId ?? "",
        packId: table.packId ?? "",
        slug: name.replace(/\.generated\.json$/, ""),
      };
    })
    .filter((row) => row.familyId !== "" && row.packId !== "")
    .sort((left, right) => left.familyId.localeCompare(right.familyId));
}

/** Manifest přesně podle toho, co na disku je. Nikdy víc. */
function writeManifest(rows: readonly ManifestRow[], note = ""): void {
  writeFileSync(MANIFEST_PATH, `// Generated by \`npm run mtt:turn-ev-build-probe\`.
${note}
import type { TurnEvPack } from "./turnEvPack";

export interface TurnEvManifestEntry {
  familyId: string;
  /** Pack, ke kterému tabulka patří; otisk se ověřuje až po načtení. */
  packId: string;
  load(): Promise<TurnEvPack>;
}

export const turnEvManifest: readonly TurnEvManifestEntry[] = [
${rows.map((row) => `  {
    familyId: "${row.familyId}",
    packId: "${row.packId}",
    load: () => import("./turn-ev/${row.slug}.generated.json").then((module) => module.default as unknown as TurnEvPack),
  },`).join("\n")}
];
`, "utf8");
}

function slugOf(packFile: string): string {
  return packFile.replace(/\.generated\.json$/, "");
}

function familyOf(packFile: string): string {
  return slugOf(packFile).replace(/-/g, "_").toUpperCase();
}

if (clean) {
  // Úklid srovná manifest s diskem **i když značka chybí**. Bez toho zůstane
  // po ručně smazané atrapě manifest odkazující na neexistující soubor a
  // repozitář se nedá sestavit - a to je horší stav než ten, ze kterého se
  // uklízelo.
  const fake = existsSync(MARKER)
    ? readFileSync(MARKER, "utf8").split("\n").map((line) => line.trim()).filter(Boolean)
    : [];
  for (const name of fake) rmSync(join(OUT_DIR, name), { force: true });
  rmSync(MARKER, { force: true });
  // Manifest se musí spravit **tady**, ne odkazem na generátor. První verze
  // říkala „přepiš generátorem" a to nešlo: manifest odkazoval na 44 smazaných
  // souborů, takže se generátor ani nespustil - esbuild padal na nevyřešených
  // importech dřív, než se dostal ke svojí práci. Úklid, po kterém zůstane
  // repozitář nesestavitelný, není úklid.
  writeManifest(survivors());
  console.log(`Sundáno ${fake.length} atrap, manifest srovnán na ${survivors().length} pravých tabulek.`);
  process.exit(0);
}

const real = existsSync(OUT_DIR)
  ? readdirSync(OUT_DIR).filter((name) => name.endsWith(".generated.json"))
  : [];
if (real.length === 0) {
  console.error("Nejdřív musí existovat aspoň jedna pravá tabulka:");
  console.error("  npm run mtt:turn-ev-pack -- --limit=1 --write");
  process.exit(2);
}

const packs = readdirSync(PACK_DIR).filter((name) => name.endsWith(".json")).sort();
mkdirSync(OUT_DIR, { recursive: true });

const fake: string[] = [];
for (const [index, packFile] of packs.entries()) {
  const target = `${slugOf(packFile)}.generated.json`;
  if (real.includes(target)) continue;
  // Kolotoč přes pravé tabulky, ať se nekopíruje pořád tatáž velikost.
  copyFileSync(join(OUT_DIR, real[index % real.length]), join(OUT_DIR, target));
  fake.push(target);
}

writeFileSync(MARKER, `${fake.join("\n")}\n`, "utf8");

const entries = survivors();
for (const packFile of packs) {
  const slug = slugOf(packFile);
  if (entries.some((row) => row.slug === slug)) continue;
  entries.push({ familyId: familyOf(packFile), packId: `ATRAPA-${slug}`, slug });
}
entries.sort((left, right) => left.familyId.localeCompare(right.familyId));

writeManifest(entries, `// POZOR: ${fake.length} z ${entries.length} položek jsou ATRAPY - kopie cizí
// tabulky pod jménem rodiny, s packId "ATRAPA-…", aby je runtime odmítl.
// Slouží k měření buildu, ne k dodání.
// Úklid: npm run mtt:turn-ev-build-probe -- --clean
`);

let bytes = 0;
for (const name of readdirSync(OUT_DIR)) {
  if (!name.endsWith(".generated.json")) continue;
  bytes += readFileSync(join(OUT_DIR, name)).length;
}

console.log(`Atrapy nasazeny: ${fake.length} kopií vedle ${real.length} pravých tabulek.`);
console.log(`turn-ev celkem: ${(bytes / 1024 / 1024).toFixed(2)} MB raw v ${entries.length} souborech`);
console.log("");
console.log("Teď se měří, jestli to projde:");
console.log("  npm run typecheck && npm run build && npm run bundle:budget");
console.log("");
console.log("A POTOM se to musí sundat:");
console.log("  npm run mtt:turn-ev-build-probe -- --clean");
console.log("Atrapy nesou EV cizí rodiny a nesmí se dostat k hráči.");
