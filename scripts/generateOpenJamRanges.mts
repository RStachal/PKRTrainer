import { readFileSync, writeFileSync } from "node:fs";

/**
 * Turn the owner's 10-20BB opening sheets into a dataset we can ship.
 *
 *   npx vite-node scripts/generateOpenJamRanges.mts -- --json=<exported chart dir>
 *
 * These sheets do not draw one opening range. They draw an open-raise band and
 * three shove thresholds, and the threshold is the depth *below* which the hand
 * goes in: short of chips there is no fold equity to play a flop with, so the
 * stack goes in; past the threshold a raise becomes affordable again.
 *
 * The colour-to-action mapping was not guessed. The button grid's four groups
 * match the hand lists recorded in Agents/reference-ranges/btn-rfi-mtt-regular.md
 * exactly - 6 open-raises, 26 at the 12BB threshold, 46 at 15BB, 4 at 20BB, 87
 * folds, 169 in total - which is what licenses applying the same mapping to the
 * sibling sheets. The small blind's grid is excluded because its legend is a
 * different one that draws limp branches, and nothing but the legend says so.
 */

interface Cluster { hex: string; hands: string[] }

/** Confirmed against the recorded button lists before being used anywhere. */
const COLOUR: Record<string, "openraise" | "fold" | number> = {
  "#D87878": "openraise",
  "#304830": 12,
  "#90A890": 15,
  "#483000": 20,
  "#F0F0F0": "fold",
};

/**
 * Which grid on which page is which seat.
 *
 * `null` means a grid deliberately left unread: the small blind's, whose legend
 * is different, and the second and third early grids, which are UTG+1 and UTG+2
 * on a nine-handed table we model with a single early seat.
 */
const PAGES: ReadonlyArray<{ file: string; seats: ReadonlyArray<string | null> }> = [
  { file: "openraising 10-20bb bu-sb.json", seats: ["BTN", null] },
  { file: "openraising 10-20bb mp-co.json", seats: ["LJ", "HJ", "CO"] },
  { file: "openraising 10-20bb utg-utg2.json", seats: ["UTG", null, null] },
];

const jsonFlag = process.argv.find((item) => item.startsWith("--json="));
const jsonDir = jsonFlag === undefined ? "" : jsonFlag.slice("--json=".length);
if (jsonDir === "") throw new Error("--json=<dir> must point at the exported 10-20BB chart folder");

const outFlag = process.argv.find((item) => item.startsWith("--out="));
const outPath = outFlag === undefined ? "src/data/ranges/openJamRanges.generated.ts" : outFlag.slice("--out=".length);

const rows: Array<{ seat: string; openraise: string[]; thresholds: Record<string, number> }> = [];

for (const page of PAGES) {
  const raw = readFileSync(`${jsonDir}/${page.file}`, "utf8").replace(/^﻿/, "");
  const parsed = JSON.parse(raw) as { page: string; grids: Array<{ clusters: Cluster[] | { value: Cluster[] } }> };

  page.seats.forEach((seat, index) => {
    if (seat === null) return;
    const source = parsed.grids[index].clusters;
    const clusters = Array.isArray(source) ? source : source.value;

    const cells = clusters.reduce((sum, cluster) => sum + cluster.hands.length, 0);
    if (cells !== 169) throw new Error(`${page.file} grid ${index + 1}: ${cells} cells, expected 169`);
    const unknown = clusters.filter((cluster) => COLOUR[cluster.hex] === undefined);
    if (unknown.length > 0) {
      throw new Error(`${page.file} grid ${index + 1}: colours outside the legend - ${unknown.map((c) => c.hex).join(", ")}`);
    }

    const thresholds: Record<string, number> = {};
    let openraise: string[] = [];
    for (const cluster of clusters) {
      const meaning = COLOUR[cluster.hex];
      if (meaning === "openraise") openraise = [...cluster.hands].sort();
      else if (typeof meaning === "number") for (const hand of cluster.hands) thresholds[hand] = meaning;
    }
    rows.push({ seat, openraise, thresholds });
  });
}

const COMBOS = (hand: string) => (hand.length === 2 ? 6 : hand.endsWith("s") ? 4 : 12);
const width = (hands: readonly string[]) => hands.reduce((sum, hand) => sum + COMBOS(hand), 0) / 1326 * 100;

const lines: string[] = [];
lines.push("// GENERATED by scripts/generateOpenJamRanges.mts - do not edit by hand.");
lines.push("//");
lines.push("// Opening between ten and twenty big blinds. Each hand carries the depth below");
lines.push("// which it shoves rather than raises, so at a given stack a hand jams when its");
lines.push("// threshold is above that stack, and open-raises otherwise. The openraise band");
lines.push("// raises at every depth the sheets cover.");
lines.push("");
lines.push("export interface OpenJamRange {");
lines.push("  readonly seat: string;");
lines.push("  /** Raises at every depth on the sheet. */");
lines.push("  readonly openraise: readonly string[];");
lines.push("  /** Hand class -> stack in BB below which it shoves instead. */");
lines.push("  readonly thresholds: Readonly<Record<string, number>>;");
lines.push("}");
lines.push("");
lines.push("export const OPEN_JAM_RANGES: readonly OpenJamRange[] = [");
for (const row of rows) {
  const entries = Object.entries(row.thresholds).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
  lines.push("  {");
  lines.push(`    seat: ${JSON.stringify(row.seat)},`);
  lines.push(`    openraise: ${JSON.stringify(row.openraise)},`);
  lines.push(`    thresholds: { ${entries.map(([h, d]) => `${JSON.stringify(h)}: ${d}`).join(", ")} },`);
  lines.push("  },");
}
lines.push("];");
lines.push("");
writeFileSync(outPath, lines.join("\n"), "utf8");

console.log(`written: ${outPath}`);
console.log("");
console.log("seat   openraise    <12BB    <15BB    <20BB   jams at 15BB");
for (const row of rows) {
  const at = (depth: number) => Object.entries(row.thresholds).filter(([, t]) => t === depth).map(([h]) => h);
  const jam15 = Object.entries(row.thresholds).filter(([, t]) => t > 15).map(([h]) => h).sort();
  console.log(
    row.seat.padEnd(7) +
    `${width(row.openraise).toFixed(1)}%`.padStart(9) +
    [12, 15, 20].map((d) => `${width(at(d)).toFixed(1)}%`.padStart(9)).join("") +
    "   " + (jam15.length > 0 ? `${width(jam15).toFixed(1)}% (${jam15.join(", ")})` : "none"),
  );
}
