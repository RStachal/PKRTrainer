import {
  existsSync,
  mkdirSync,
  readFileSync,
  readdirSync,
  renameSync,
  rmSync,
  writeFileSync,
} from "node:fs";
import { basename, dirname, join } from "node:path";
import {
  mttProductionImportIdentityFromPackId,
  mttProductionImportSlotId,
} from "../src/data/ranges/mttImportSlotNaming";

export type MttGeneratedProductionKind =
  | "mtt-preflop"
  | "flop-production"
  | "turn-production"
  | "river-production";

export interface MttGeneratedProductionModule {
  kind: MttGeneratedProductionKind;
  packId: string;
  exportName: string;
  modulePath: string;
  importPath: string;
  profileKey: string;
}

export interface MttProductionRegistryRefreshResult {
  changed: boolean;
  modules: readonly MttGeneratedProductionModule[];
  registryPath: string;
  text: string;
}

export const MTT_PRODUCTION_REGISTRY_PATH =
  "src/data/ranges/mttProductionRegistry.generated.ts";

const GENERATED_MODULE_NAME =
  basename(MTT_PRODUCTION_REGISTRY_PATH).toLowerCase();

export function discoverMttProductionModules(
  rangeDir = "src/data/ranges",
): MttGeneratedProductionModule[] {
  if (!existsSync(rangeDir)) return [];

  return readdirSync(rangeDir, { withFileTypes: true })
    .filter((entry) => (
      entry.isFile() &&
      entry.name.endsWith(".ts") &&
      entry.name.toLowerCase() !== GENERATED_MODULE_NAME &&
      entry.name.startsWith("mtt-") &&
      entry.name.includes("-production-")
    ))
    .map((entry) => productionModuleFromFile(join(rangeDir, entry.name)))
    .filter((item): item is MttGeneratedProductionModule => item !== null)
    .sort((a, b) => a.packId.localeCompare(b.packId));
}

export function renderMttProductionRegistry(
  modules: readonly MttGeneratedProductionModule[],
): string {
  return [
    "// Generated by `npm run mtt:refresh-registry -- --write`.",
    "// Do not edit by hand.",
    "",
    'import type { RangePack } from "./rangePack";',
    'import type { FlopProductionStrategyPack } from "./flopProductionStrategyPack";',
    'import type { TurnProductionStrategyPack } from "./turnProductionStrategyPack";',
    'import type { RiverProductionStrategyPack } from "./riverProductionStrategyPack";',
    "",
    "export type GeneratedMttProductionPack =",
    "  | RangePack",
    "  | FlopProductionStrategyPack",
    "  | TurnProductionStrategyPack",
    "  | RiverProductionStrategyPack;",
    "",
    "export interface GeneratedMttProductionManifestEntry {",
    "  kind: \"mtt-preflop\" | \"flop-production\" | \"turn-production\" | \"river-production\";",
    "  packId: string;",
    "  profileKey: string;",
    "  load(): Promise<GeneratedMttProductionPack>;",
    "}",
    renderLazyManifest(modules),
    "",
  ].join("\n");
}

export function refreshMttProductionRegistry(
  options: {
    rangeDir?: string;
    registryPath?: string;
    write?: boolean;
  } = {},
): MttProductionRegistryRefreshResult {
  const registryPath = options.registryPath ?? MTT_PRODUCTION_REGISTRY_PATH;
  const modules = discoverMttProductionModules(options.rangeDir);
  const text = renderMttProductionRegistry(modules);
  const current = existsSync(registryPath)
    ? readFileSync(registryPath, "utf8")
    : "";
  const changed = current !== text;

  if (options.write === true && changed) {
    writeRegistryAtomically(registryPath, text);
  }

  return {
    changed,
    modules,
    registryPath,
    text,
  };
}

function writeRegistryAtomically(registryPath: string, text: string): void {
  const directory = dirname(registryPath);
  mkdirSync(directory, { recursive: true });
  const temporaryPath = join(
    directory,
    `.${basename(registryPath)}.${process.pid}.${Date.now()}.tmp`,
  );
  try {
    writeFileSync(temporaryPath, text, "utf8");
    renameSync(temporaryPath, registryPath);
  } catch (error) {
    rmSync(temporaryPath, { force: true });
    throw error;
  }
}

function productionModuleFromFile(
  modulePath: string,
): MttGeneratedProductionModule | null {
  const content = readFileSync(modulePath, "utf8");
  const packId = content.match(/"id":\s*"([^"]+)"/)?.[1];
  const exportName = content.match(/export const\s+([A-Za-z_$][A-Za-z0-9_$]*)\s*=/)?.[1];
  if (!packId || !exportName) return null;

  const kind = kindForPackId(packId);
  const identity = mttProductionImportIdentityFromPackId(packId);
  if (kind === null || identity === null) return null;

  const fileName = basename(modulePath, ".ts");
  return {
    kind,
    packId,
    exportName,
    modulePath: modulePath.replace(/\\/g, "/"),
    importPath: `./${fileName}`,
    profileKey: mttProductionImportSlotId(identity),
  };
}

function kindForPackId(packId: string): MttGeneratedProductionKind | null {
  if (!packId.startsWith("mtt-") || !packId.includes("-production-")) {
    return null;
  }
  if (packId.includes("-preflop-")) return "mtt-preflop";
  if (packId.includes("-flop-")) return "flop-production";
  if (packId.includes("-turn-")) return "turn-production";
  if (packId.includes("-river-")) return "river-production";
  return null;
}

function renderLazyManifest(
  modules: readonly MttGeneratedProductionModule[],
): string {
  if (modules.length === 0) {
    return "export const generatedMttProductionManifest: readonly GeneratedMttProductionManifestEntry[] = [];";
  }
  return [
    "export const generatedMttProductionManifest: readonly GeneratedMttProductionManifestEntry[] = [",
    ...modules.flatMap((module) => [
      "  {",
      `    kind: ${JSON.stringify(module.kind)},`,
      `    packId: ${JSON.stringify(module.packId)},`,
      `    profileKey: ${JSON.stringify(module.profileKey)},`,
      `    load: () => import(${JSON.stringify(module.importPath)}).then((module) => module.${module.exportName}),`,
      "  },",
    ]),
    "];",
  ].join("\n");
}
