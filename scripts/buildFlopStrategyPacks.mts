import type { FlopStrategyRule } from "../src/data/ranges/flopStrategyRuleBuilder";
import { existsSync, mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";
import { seatsOfFamily,
  trimToModuleBudget,
  supersededByRepair,
  fullTreeBoardsByFamily,
  MODULE_BUDGET_BYTES,
  PACK_ENVELOPE_BYTES,
} from "./lib/solvedPackBuilding.mts";
import { subgameDecisions } from "./lib/subgameDecisions.mts";
import { buildFlopStrategyRule } from "../src/data/ranges/flopStrategyRuleBuilder";
import { buildFlopSolvedStrategyPack } from "../src/data/ranges/flopSolvedStrategyPack";
import { actionNodeForSolvedHero } from "../src/data/ranges/solvedHeroActionNode";
import { TURN_COVERAGE_TARGET, type TurnFamilyEvidence } from "../src/data/ranges/turnReviewGate";
import {
  parseTurnReviewVerdicts,
  type TurnReviewVerdictRecord,
} from "../src/data/ranges/turnReviewVerdict";
import { manifestLoadExpression, readManifestEntries } from "./lib/manifestEntries.mts";

/**
 * Postaví flopový pack z jedné rodiny.
 *
 *   npm run mtt:flop-pack -- --family=MTT9_20BB_BTN_BB_SRP_LOWSPR [--write]
 *
 * Čte monolitické checkpointy, ne dekompozici. Kořen checkpointu je flopový
 * akční uzel se strategií po kombinacích - tedy přesně to, co se dosud četlo jen
 * kvůli tomu, aby se z něj naplánovaly turnové podhry, a pak zahodilo.
 *
 * Checkpoint má kolem sta megabajtů a načte se za necelé dvě vteřiny; flopový
 * strom v něm má přes čtyřicet rozhodnutí pro oba hráče. Žádný nový solve to
 * nestojí.
 *
 * Rozhodnutí, pro která produkt nemá jméno - hráč v pozici hrající po checku bez
 * iniciativy - se nedodávají: trenažér takový spot nerozdá, takže by pravidlo
 * neodpovědělo nikomu.
 */

const CHECKPOINT_ROOT = "Agents/solver-input/gto-plus/sample-postflop-v1/output/texas-solver";
const PARAM_ROOT = "Agents/solver-input/texas-solver/mtt-safe-flops-v1/parameters";
const OUT_DIR = "src/data/ranges/flop";
const MANIFEST_PATH = "src/data/ranges/flopSolvedManifest.generated.ts";
const PROFILE_KEY = "FULL_RING_9|REGULAR|CHIP_EV|FLOP";

/** Stejný rozpočet jako u turnu: rodina je vlastní chunk s limitem 512 KiB. */
const RULE_BUDGET = 260;

interface ManifestEntry { familyId: string; packId: string; slug: string }

/** Pot, efektivní stack a deska, se kterými se ten board solvil. */
function parametersFor(family: string, board: string): {
  potChips: number; stackChips: number; flop: string[];
} | undefined {
  const stack: string[] = [PARAM_ROOT];
  while (stack.length > 0) {
    const directory = stack.pop()!;
    if (!existsSync(directory)) continue;
    for (const entry of readdirSync(directory, { withFileTypes: true })) {
      const path = join(directory, entry.name);
      if (entry.isDirectory()) { stack.push(path); continue; }
      if (!entry.name.endsWith(".txt")) continue;
      // Jméno nese pořadové číslo, rodinu a desku: 04_MTT9_..._654r.txt
      const stem = entry.name.slice(0, -4).replace(/^\d+_/, "");
      if (stem !== `${family}_${board}`) continue;
      const text = readFileSync(path, "utf8");
      const pot = /set_pot\s+([\d.]+)/.exec(text);
      const chips = /set_effective_stack\s+([\d.]+)/.exec(text);
      const flop = /set_board\s+([^\r\n]+)/.exec(text);
      if (pot === null || chips === null || flop === null) return undefined;
      return {
        potChips: Number(pot[1]),
        stackChips: Number(chips[1]),
        flop: flop[1].split(",").map((card) => card.trim()).filter(Boolean),
      };
    }
  }
  return undefined;
}

function writeManifestEntry(added: ManifestEntry): void {
  const existing: ManifestEntry[] = [];
  if (existsSync(MANIFEST_PATH)) {
    const source = readFileSync(MANIFEST_PATH, "utf8");
    existing.push(...readManifestEntries(source, "flop"));
  }
  const entries = [...existing.filter((item) => item.familyId !== added.familyId), added]
    .sort((left, right) => left.familyId.localeCompare(right.familyId));

  const body = entries.map((entry) => `  {
    familyId: "${entry.familyId}",
    packId: "${entry.packId}",
    profileKey: "${PROFILE_KEY}",
    load: ${manifestLoadExpression("flop", entry.slug, "FlopSolvedStrategyPack")},
  },`).join("\n");

  writeFileSync(MANIFEST_PATH, `// Generated by \`npm run mtt:flop-pack -- --write\`.
// Do not edit by hand.

import type { FlopSolvedStrategyPack } from "./flopSolvedStrategyPack";

export interface SolvedFlopManifestEntry {
  familyId: string;
  packId: string;
  profileKey: string;
  load(): Promise<FlopSolvedStrategyPack>;
}

export const solvedFlopManifest: readonly SolvedFlopManifestEntry[] = [
${body}
];
`, "utf8");
}

const VERDICTS_PATH = "Agents/turn-review/verdicts.json";

/** Zaznamenané verdikty hráčů; bez souboru se nic neděje a rodina zůstane LOW. */
function readVerdicts(): TurnReviewVerdictRecord[] {
  if (!existsSync(VERDICTS_PATH)) return [];
  return parseTurnReviewVerdicts(readFileSync(VERDICTS_PATH, "utf8"));
}

const familyArg = process.argv.find((item) => item.startsWith("--family="));
const write = process.argv.includes("--write");
const family = familyArg?.split("=")[1];

if (family === undefined) {
  console.error("Usage: npm run mtt:flop-pack -- --family=<FAMILY_ID> [--write]");
  process.exitCode = 2;
} else if (
  existsSync(MANIFEST_PATH) &&
  supersededByRepair(family, readFileSync(MANIFEST_PATH, "utf8")) !== undefined
) {
  // Stejná kontrola jako na turnu. Bez ní se dodávala riverová strategie z
  // rodiny, kterou produkt na ostatních ulicích odmítá.
  const winner = supersededByRepair(family, readFileSync(MANIFEST_PATH, "utf8"));
  console.error(
    `${family} už nahradila ${winner}; obě řeší tentýž spot a resolver by odpověděl `
    + "z té, která je v řetězci první. Postav a shipuj jen tu opravenou.",
  );
  process.exitCode = 2;
} else if (!existsSync(join(CHECKPOINT_ROOT, family, "raw"))) {
  console.error(`${family} nemá checkpointy; není z čeho stavět.`);
  process.exitCode = 1;
} else {
  const rawDirectory = join(CHECKPOINT_ROOT, family, "raw");
  const seats = seatsOfFamily(`${family}__probe`);
  const familyStackBB = Number(/_(\d+)BB_/.exec(family)?.[1] ?? 0);
  // Desky vyřešené na redukovaném stromě se vynechávají, stejně jako u turnu.
  //
  // Redukovaný strom je paměťově úsporná varianta pro review; nemá turnový donk
  // a nemá pozdější zvýšení, takže je to jiná hra. Agregát, do kterého spadnou
  // obě, míchá dvě různé hry a v UI to nikdo nepozná. Turnový generátor tenhle
  // filtr měl od začátku, flopový ne - a přitom čte tytéž checkpointy.
  const fullTreeBoards = fullTreeBoardsByFamily().get(family.toUpperCase());
  const allFiles = readdirSync(rawDirectory).filter((name) => (
    name.startsWith(`pkrtrainer_${family}_`) && name.endsWith(".json")
  ));
  const boardOf = (name: string) => name.slice(`pkrtrainer_${family}_`.length, -".json".length);
  const files = fullTreeBoards === undefined
    ? allFiles
    : allFiles.filter((name) => fullTreeBoards.has(boardOf(name)));
  const droppedReduced = allFiles.length - files.length;
  if (droppedReduced > 0) {
    console.log(`  ${droppedReduced} boardů vynecháno: vyřešené na redukovaném stromě`);
  }

  const evidence: TurnFamilyEvidence = {
    familyId: family,
    boards: 0,
    boardsWithCheckpoint: files.length,
    plannedItems: 0, writtenItems: 0,
    minCoverage: 1, coverageTarget: TURN_COVERAGE_TARGET, sampledRules: [],
  };
  const rules: FlopStrategyRule[] = [];
  let unnamed = 0;
  /** Kolik se přečetlo a postavilo, než se slučovalo. Viz body 194 a 197. */
  let subgameBytes = 0;
  let built = 0;
  let boards = 0;

  for (const file of files) {
    const board = file.slice(`pkrtrainer_${family}_`.length, -".json".length);
    const parameters = parametersFor(family, board);
    if (parameters === undefined || parameters.flop.length !== 3) continue;
    const raw = readFileSync(join(rawDirectory, file), "utf8");
    subgameBytes += raw.length;
    const node = JSON.parse(raw);
    evidence.boards += 1;
    boards += 1;

    const chipsPerBB = familyStackBB > 0 ? parameters.stackChips / familyStackBB : 0;
    const inBB = (chips: number) => (
      chipsPerBB > 0 ? Math.round((chips / chipsPerBB) * 10) / 10 : undefined
    );

    for (const decision of subgameDecisions(node, parameters.potChips, parameters.stackChips)) {
      // Strana stolu ze solverova údaje o hráči na tahu. Překryv ranží tu nejde:
      // checkpoint plán s ranžemi nenese, ten vzniká až dekompozicí.
      const side = decision.player === 1 ? "OOP" as const : "IP" as const;
      if (seats === undefined) { unnamed += 1; continue; }
      const seat = side === "OOP" ? seats.oop : seats.ip;
      const hero = {
        side,
        seat,
        villainSeat: side === "OOP" ? seats.ip : seats.oop,
        isAggressor: seat === seats.aggressor,
        confidence: 1,
        facingBet: decision.toCallChips > 0,
      };
      const rule = buildFlopStrategyRule(`${family}__${board}`, decision.node, {
        flop: parameters.flop,
        priorLine: decision.line,
        potChips: decision.potChips,
        stackChips: decision.stackChips,
      }, {
        hero,
        ...(inBB(decision.potChips) === undefined ? {} : { potBB: inBB(decision.potChips) }),
        ...(inBB(decision.stackChips) === undefined
          ? {}
          : { stackBehindBB: inBB(decision.stackChips) }),
        reach: decision.arrival,
      });
      if (rule === undefined) continue;
      if (actionNodeForSolvedHero(hero, "FLOP", rule.potType) === undefined) {
        unnamed += 1;
        continue;
      }
      // Do „naplánováno" se počítá až rozhodnutí, které produkt umí pojmenovat.
      //
      // Brána porovnává zapsané s naplánovaným a schodek čte jako chybějící
      // práci. Rozhodnutí, pro které produkt jméno nemá, ale chybějící práce
      // není - je to vědomé vynechání, a započítat ho by rodinu zablokovalo za
      // něco, co se dodat nemělo. Tři rodiny se small blindem takhle propadly.
      evidence.plannedItems += 1;
      evidence.writtenItems += 1;
      rules.push(rule);
      built += 1;
    }
  }

  const decisionKey = (rule: (typeof rules)[number]): string => {
    const hero = rule.spot?.hero;
    return `${actionNodeForSolvedHero(hero, "FLOP", rule.potType) ?? "?"}|${hero?.side ?? "?"}`;
  };

  // Jedno pravidlo na desku a rozhodnutí, to nejčastěji dosahované: resolver
  // linky nerozlišuje, takže dodat dvě znamená odmítnout obě.
  // Bez úklidu měří `heapUsed` i odpad, který jen ještě nikdo nesebral - a to je
  // rozdíl mezi „něco se drží" a „něco se právě alokovalo a zahodilo". Když je
  // úklid k dispozici (--expose-gc), měří se až po něm.
  const gc = (globalThis as { gc?: () => void }).gc;
  const before = Math.round(process.memoryUsage().heapUsed / 1048576);
  gc?.();
  const live = Math.round(process.memoryUsage().heapUsed / 1048576);
  console.log(
    `  halda po sběru ${before} MB, po úklidu ${gc === undefined ? "neměřeno" : `${live} MB`}: `
    + `${built} pravidel postaveno, ${boards} desek `
    + `(${Math.round(subgameBytes / 1048576)} MB textu)`,
  );

  const byLine = new Map<string, (typeof rules)[number]>();
  for (const rule of rules) {
    const key = `${rule.flopSpot.flop.join("")}|${decisionKey(rule)}`;
    const held = byLine.get(key);
    if (held === undefined || (rule.spot?.reach ?? 0) > (held.spot?.reach ?? 0)) {
      byLine.set(key, rule);
    }
  }
  const collapsed = rules.length - byLine.size;
  rules.length = 0;
  rules.push(...byLine.values());
  if (collapsed > 0) console.log(`  ${collapsed} rozhodnutí vynecháno: tutéž situaci dosahuje jiná linka častěji`);

  // Rozpočet rovným dílem mezi rozhodnutí, uvnitř střídavě po deskách.
  const byDecision = new Map<string, Map<string, typeof rules>>();
  for (const rule of rules) {
    const decision = decisionKey(rule);
    const boards = byDecision.get(decision) ?? new Map<string, typeof rules>();
    const bucket = boards.get(rule.sourceDirectory) ?? [];
    bucket.push(rule);
    boards.set(rule.sourceDirectory, bucket);
    byDecision.set(decision, boards);
  }
  const kept: typeof rules = [];
  const share = Math.max(1, Math.floor(RULE_BUDGET / Math.max(1, byDecision.size)));
  for (const boards of byDecision.values()) {
    for (const bucket of boards.values()) {
      bucket.sort((left, right) => (right.spot?.reach ?? 0) - (left.spot?.reach ?? 0));
    }
    const queues = [...boards.values()];
    let taken = 0;
    for (let round = 0; taken < share && kept.length < RULE_BUDGET; round += 1) {
      let placed = 0;
      for (const queue of queues) {
        if (round >= queue.length) continue;
        if (taken >= share || kept.length >= RULE_BUDGET) break;
        kept.push(queue[round]);
        taken += 1;
        placed += 1;
      }
      if (placed === 0) break;
    }
  }
  const dropped = rules.length - kept.length;
  rules.length = 0;
  rules.push(...kept);
  evidence.sampledRules = rules.slice(0, 1);
  if (dropped > 0) console.log(`  ${dropped} méně dosahovaných rozhodnutí vynecháno kvůli rozpočtu`);

  const identities = new Map<string, number>();
  for (const rule of rules) {
    const hero = rule.spot?.hero;
    if (hero === undefined) continue;
    const key = `${hero.side} ${hero.seat} vs ${hero.villainSeat}, `
      + `${hero.facingBet ? "čelí sázce" : hero.isAggressor ? "c-bet" : "lead"}`;
    identities.set(key, (identities.get(key) ?? 0) + 1);
  }
  for (const [key, count] of [...identities].sort()) {
    console.log(`  hrdina: ${key} - ${count} rozhodnutí`);
  }
  if (unnamed > 0) console.log(`  ${unnamed} rozhodnutí vynecháno: produkt pro ně nemá jméno`);

  const packId = `mtt-full-ring-9-flop-solved-${family.toLowerCase().replace(/_/g, "-")}-v1`;
  const createdAt = new Date().toISOString().slice(0, 10);
  const verdicts = readVerdicts();
  const buildWith = (candidate: typeof rules) => buildFlopSolvedStrategyPack({
    id: packId, createdAt, evidence, rules: candidate, verdicts,
  });

  // Strop v bajtech, ne v pravidlech - viz `trimToModuleBudget`. Tahle ulice se
  // do rozpočtu dnes vejde, ale ze stejného důvodu jako river se vejít nemusí:
  // `RULE_BUDGET` neví, kolik místa pravidlo zabere.
  // Měří se pravidla, ne hotový pack: velikost packu závisí na textu o důvěře,
  // takže by přijatý verdikt měnil ořez a tím i otisk, na který je verdikt
  // vázaný. Viz `trimToModuleBudget`.
  const fitted = trimToModuleBudget(
    rules,
    (candidate) => JSON.stringify(candidate).length,
    MODULE_BUDGET_BYTES - PACK_ENVELOPE_BYTES,
  );
  if (fitted.dropped > 0) {
    console.log(`  ${fitted.dropped} rozhodnutí vynecháno, aby se modul vešel do rozpočtu svazku`);
    rules.length = 0;
    rules.push(...fitted.kept);
  }

  const result = buildWith(rules);

  if (!result.ok) {
    console.error(result.reason);
    process.exitCode = 1;
  } else {
    const module = JSON.stringify(result.pack);
    const slug = family.toLowerCase().replace(/_/g, "-");
    const outPath = join(OUT_DIR, `${slug}.generated.json`);
    console.log(`family ${family}`);
    console.log(`  desek ${evidence.boards} z ${evidence.boardsWithCheckpoint}, pravidel ${rules.length}, modul ${(module.length / 1024).toFixed(0)} KB`);
    console.log(`  důvěra ${result.pack.confidence}, otisk ${result.pack.contentHash}`);
    console.log(`  ${write ? "written" : "would write"}: ${outPath}`);
    if (write) {
      mkdirSync(dirname(outPath), { recursive: true });
      writeFileSync(outPath, module, "utf8");
      writeManifestEntry({ familyId: family, packId: result.pack.id, slug });
      console.log(`  manifest updated: ${MANIFEST_PATH}`);
    }
  }
}
