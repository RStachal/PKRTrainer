{
  "name": "mtt-preflop-trainer",
  "version": "0.1.0",
  "description": "MTT Preflop Trainer - offline full-ring 9-handed poker decision trainer built with Vanilla TypeScript and Vite.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:ranges": "vite-node scripts/verifyRanges.mts",
    "validate:range-import": "vite-node scripts/validateRangeImport.mts",
    "build:range-module": "vite-node scripts/buildRangeModule.mts",
    "mtt:completion": "vite-node scripts/checkMttCompletion.mts",
    "mtt:core-release": "vite-node scripts/checkMttCoreRelease.mts",
    "mtt:blockers": "vite-node scripts/checkMttBlockers.mts",
    "mtt:intake-plan": "vite-node scripts/checkMttIntakePlan.mts",
    "mtt:postflop-matrix": "vite-node scripts/checkMttPostflopMatrix.mts",
    "mtt:postflop-coverage": "vite-node scripts/checkMttPostflopProductionCoverage.mts",
    "mtt:postflop-positions": "vite-node scripts/checkMttPostflopPositions.mts",
    "mtt:postflop-release": "vite-node scripts/checkMttPostflopReleaseGate.mts",
    "mtt:solver-verification": "vite-node scripts/checkMttSolverVerification.mts",
    "mtt:texas-solver-review-protocol": "vite-node scripts/checkTexasSolverReviewProtocol.mts",
    "mtt:texas-solver-review-readiness": "vite-node scripts/checkTexasSolverReviewReadiness.mts",
    "mtt:texas-solver-owner-review": "vite-node scripts/recordTexasSolverOwnerReview.mts",
    "mtt:texas-solver-owner-review-batch": "vite-node scripts/recordTexasSolverOwnerReviewBatch.mts",
    "mtt:texas-solver-accuracy-recovery": "vite-node scripts/prepareTexasSolverAccuracyRecovery.mts",
    "mtt:texas-solver-accuracy-handoff": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/finalize-texas-solver-accuracy-recovery.ps1",
    "mtt:stage-texas-solver": "vite-node scripts/stageTexasSolverExports.mts",
    "mtt:texas-solver-pack": "vite-node scripts/checkTexasSolverParameterPack.mts",
    "mtt:texas-solver-review": "vite-node scripts/extractTexasSolverReview.mts",
    "mtt:texas-solver-review-only-refresh": "vite-node scripts/refreshTexasSolverReviewOnlyEvidence.mts",
    "mtt:texas-solver-scenario-audit": "vite-node scripts/auditTexasSolverScenarioBatch.mts",
    "mtt:texas-solver-3bp-repair-batch": "vite-node scripts/buildTexasSolver3bpRepairBatch.mts",
    "mtt:texas-solver-3bp-expansion-batch": "vite-node scripts/buildTexasSolver3bpExpansionBatch.mts",
    "mtt:texas-solver-facing-bet-expansion-batch": "vite-node scripts/buildTexasSolverFacingBetExpansionBatch.mts",
    "mtt:texas-solver-srp-facing-bet-batch": "vite-node scripts/buildTexasSolverSrpFacingBetBatch.mts",
    "mtt:texas-solver-srp-sb-bb-cbet-batch": "vite-node scripts/buildTexasSolverSrpSbBbCbetBatch.mts",
    "mtt:texas-solver-srp-co-bb-cbet-batch": "vite-node scripts/buildTexasSolverSrpCoBbCbetBatch.mts",
    "mtt:texas-solver-large-flop-batch": "vite-node scripts/buildTexasSolverLargeFlopBatch.mts",
    "mtt:texas-solver-board-catalog": "vite-node scripts/checkTexasSolverBoardCatalog.mts",
    "mtt:texas-solver-coverage-batch": "vite-node scripts/buildTexasSolverCoverageBatch.mts",
    "mtt:texas-solver-coverage-status": "vite-node scripts/checkTexasSolverCoverageBatchStatus.mts",
    "mtt:texas-solver-coverage-overview": "vite-node scripts/checkTexasSolverCoverageOverview.mts",
    "mtt:texas-solver-background-status": "vite-node scripts/checkTexasSolverBackgroundStatus.mts",
    "mtt:texas-solver-overnight": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/start-background-solve.ps1 -MinimumFreeMemoryPercent 10 -MaximumCpuPercent 100 -ProcessPriority AboveNormal -StopBelowFreeMemoryPercent 10 -ContinueOnSolverFailure",
    "mtt:texas-solver-queue": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/resume-texas-solver-queue.ps1",
    "mtt:texas-solver-autostart-install": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-texas-solver-autostart.ps1 -Action Install -StartNow",
    "mtt:texas-solver-autostart-status": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-texas-solver-autostart.ps1 -Action Status",
    "mtt:texas-solver-autostart-stop": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-texas-solver-autostart.ps1 -Action Stop",
    "mtt:texas-solver-autostart-uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-texas-solver-autostart.ps1 -Action Uninstall",
    "mtt:texas-solver-low-memory": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/run-texas-solver-low-memory.ps1",
    "mtt:texas-solver-low-memory-install": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-texas-solver-low-memory.ps1 -Action Install -StartNow",
    "mtt:texas-solver-low-memory-status": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-texas-solver-low-memory.ps1 -Action Status",
    "mtt:texas-solver-low-memory-stop": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-texas-solver-low-memory.ps1 -Action Stop",
    "mtt:texas-solver-low-memory-uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-texas-solver-low-memory.ps1 -Action Uninstall",
    "mtt:autonomous-cycle-install": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-mtt-autonomous-cycle.ps1 -Action Install -StartNow",
    "mtt:autonomous-cycle-ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-mtt-autonomous-cycle.ps1 -Action Ensure -StartNow",
    "mtt:autonomous-cycle-status": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-mtt-autonomous-cycle.ps1 -Action Status",
    "mtt:autonomous-cycle-stop": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-mtt-autonomous-cycle.ps1 -Action Stop",
    "mtt:autonomous-cycle-uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-mtt-autonomous-cycle.ps1 -Action Uninstall",
    "mtt:solver-batch-prep-install": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-mtt-solver-batch-prep.ps1 -Action Install -StartNow",
    "mtt:solver-batch-prep-status": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-mtt-solver-batch-prep.ps1 -Action Status",
    "mtt:solver-batch-prep-stop": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-mtt-solver-batch-prep.ps1 -Action Stop",
    "mtt:solver-batch-prep-uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File Agents/solver-input/texas-solver/mtt-safe-flops-v1/manage-mtt-solver-batch-prep.ps1 -Action Uninstall",
    "mtt:texas-solver-ingest-completed": "vite-node scripts/ingestTexasSolverCompletedCoverage.mts",
    "mtt:texas-solver-pilot-refresh": "vite-node scripts/refreshTexasSolverPilotWorkflow.mts",
    "mtt:texas-solver-normalize-draft": "vite-node scripts/buildTexasSolverNormalizedDraft.mts",
    "mtt:texas-solver-facing-bet-candidates": "vite-node scripts/buildTexasSolverFacingBetCandidates.mts",
    "mtt:texas-solver-merge-pilot-drafts": "vite-node scripts/mergeTexasSolverPilotDrafts.mts",
    "mtt:texas-solver-viewer": "vite-node scripts/buildTexasSolverReviewViewer.mts",
    "mtt:postflop-pilot-gate": "vite-node scripts/checkMttPostflopPilotGate.mts",
    "mtt:postflop-pilot-suite": "vite-node scripts/checkMttPostflopPilotSuite.mts",
    "mtt:postflop-pilot-catalog": "vite-node scripts/checkMttPostflopPilotCatalog.mts",
    "mtt:postflop-pilot-modules": "vite-node scripts/buildMttPostflopPilotModules.mts",
    "mtt:postflop-action-ev-intake": "vite-node scripts/prepareMttPostflopActionEvIntake.mts",
    "mtt:release-gates": "vite-node scripts/checkMttReleaseGates.mts",
    "mtt:acceptance": "vite-node scripts/checkMttAcceptance.mts",
    "mtt:technical-acceptance": "vite-node scripts/checkMttTechnicalAcceptance.mts",
    "mtt:handoff": "vite-node scripts/writeMttHandoffArtifacts.mts",
    "mtt:scenario-catalog": "vite-node scripts/checkMttScenarioCatalog.mts",
    "mtt:utility-stats": "vite-node scripts/checkMttUtilityStats.mts",
    "mtt:content-packs": "vite-node scripts/checkMttContentPacks.mts",
    "mtt:variant-qa": "vite-node scripts/checkMttVariantQa.mts",
    "mtt:next-action": "vite-node scripts/reportNextMttAction.mts",
    "mtt:p1-intake-packets": "vite-node scripts/reportNextMttAction.mts --priority=P1_PREFLOP_CHIP_EV --all-packets --packet-dir=artifacts/mtt-next-action/p1-preflop-chip-ev --output=artifacts/mtt-next-action/p1-preflop-chip-ev-report.json --summary",
    "mtt:promote-ready": "vite-node scripts/promoteReadyMttIntake.mts",
    "mtt:refresh-registry": "vite-node scripts/refreshMttProductionRegistry.mts",
    "mtt:registry-integrity": "vite-node scripts/checkMttProductionRegistryIntegrity.mts",
    "mtt:validate-ready-intake": "vite-node scripts/validateMttReadyIntake.mts",
    "mtt:slots": "vite-node scripts/listMttImportSlots.mts",
    "mtt:p1-preflop-drafts": "vite-node scripts/buildMttP1PreflopDrafts.mts",
    "mtt:p1-stage-reviewed-preflop": "vite-node scripts/stageMttP1ReviewedPreflopIntake.mts",
    "mtt:preflop-csv-scaffold": "vite-node scripts/buildMttPreflopCsvScaffold.mts",
    "mtt:preflop-csv-draft": "vite-node scripts/buildMttPreflopCsvDraft.mts",
    "mtt:sixmax-preflop-intake-batch": "vite-node scripts/runMttSixMaxPreflopIntakeBatch.mts",
    "mtt:sixmax-preflop-intake-progress": "vite-node scripts/runMttSixMaxPreflopIntakeBatch.mts --incremental --summary",
    "mtt:sixmax-preflop-workbench-refresh": "vite-node scripts/runMttSixMaxPreflopIntakeBatch.mts --incremental --refresh-blank-scaffolds --output=artifacts/mtt-sixmax-preflop-intake/workbench-refresh-report.json --summary",
    "mtt:sixmax-preflop-stage-batch": "vite-node scripts/stageMttSixMaxPreflopIntakeBatch.mts",
    "mtt:sixmax-preflop-stage-progress": "vite-node scripts/stageMttSixMaxPreflopIntakeBatch.mts --incremental --summary",
    "range:intake": "vite-node scripts/checkRangeIntakeStatus.mts",
    "range:intake:guard": "vite-node scripts/checkRangeIntakeWorkspace.mts",
    "range:cross-check-sample": "vite-node scripts/buildRangeCrossCheckSample.mts",
    "range:cross-check-compare": "vite-node scripts/compareRangeCrossCheckSample.mts",
    "bundle:budget": "vite-node scripts/checkBundleBudget.mts",
    "verify:precache": "vite-node scripts/checkDistPrecache.mts",
    "profile:render": "vite-node scripts/profileRenderPerformance.mts",
    "e2e:chrome": "vite-node scripts/runChromeE2e.mts",
    "e2e:chrome:preview": "vite-node scripts/runChromePreviewE2e.mts",
    "e2e:chrome:production-fixture": "vite-node scripts/runChromeProductionFixtureE2e.mts",
    "e2e:android:preflight": "vite-node scripts/checkAndroidDeviceAvailability.mts",
    "release:mtt-core": "npm run typecheck && npm test && npm run mtt:refresh-registry -- --check && npm run mtt:core-release && npm run verify:ranges && npm run build && npm run verify:precache && npm run bundle:budget",
    "release:check": "npm run typecheck && npm test && npm run mtt:refresh-registry -- --check && npm run mtt:release-gates && npm run verify:ranges && npm run build && npm run verify:precache && npm run bundle:budget",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
