{
  "name": "mtt-preflop-trainer",
  "version": "0.1.0",
  "description": "MTT Preflop Trainer - offline full-ring 9-handed poker decision trainer built with Vanilla TypeScript and Vite.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:ranges": "vite-node scripts/verifyRanges.mts",
    "validate:range-import": "vite-node scripts/validateRangeImport.mts",
    "build:range-module": "vite-node scripts/buildRangeModule.mts",
    "mtt:completion": "vite-node scripts/checkMttCompletion.mts",
    "mtt:blockers": "vite-node scripts/checkMttBlockers.mts",
    "mtt:intake-plan": "vite-node scripts/checkMttIntakePlan.mts",
    "mtt:postflop-matrix": "vite-node scripts/checkMttPostflopMatrix.mts",
    "mtt:validate-ready-intake": "vite-node scripts/validateMttReadyIntake.mts",
    "mtt:slots": "vite-node scripts/listMttImportSlots.mts",
    "range:intake": "vite-node scripts/checkRangeIntakeStatus.mts",
    "range:intake:guard": "vite-node scripts/checkRangeIntakeWorkspace.mts",
    "bundle:budget": "vite-node scripts/checkBundleBudget.mts",
    "profile:render": "vite-node scripts/profileRenderPerformance.mts",
    "release:check": "npm run typecheck && npm test && npm run mtt:completion && npm run mtt:blockers -- --summary && npm run range:intake:guard && npm run range:intake -- --ready-only && npm run mtt:validate-ready-intake && npm run verify:ranges && npm run build && npm run bundle:budget",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
