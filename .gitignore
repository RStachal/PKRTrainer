# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
dist-e2e-*/
artifacts/

# Generated FTP release packages
deploy/pkrtrainer-ftp-*/
deploy/pkrtrainer-ftp-*.zip
deploy/pkrtrainer-ftp-*.manifest.txt
deploy/pkrtrainer-ftp-*.manifest.json

# Local solver workspaces / raw exports
# Keep generated solver outputs local until they are reviewed and converted
# through the canonical range-intake pipeline.
Agents/solver-input/gto-plus/sample-postflop-v1/output/gto-plus/
Agents/solver-input/gto-plus/sample-postflop-v1/output/texas-solver/

# Restart-safe accuracy recovery is a shrinking local checkpoint queue.
Agents/solver-input/texas-solver/mtt-safe-flops-v1/coverage-accuracy-recovery-v1-manifest.json
Agents/solver-input/texas-solver/mtt-safe-flops-v1/parameters/pkrtrainer_mtt_accuracy_recovery_v1/

# The accuracy re-solve batch is derived from local solver evidence and becomes
# obsolete once its boards converge. Regenerate it with
# npm run mtt:texas-solver-accuracy-resolve-batch -- --write
Agents/solver-input/texas-solver/mtt-safe-flops-v1/accuracy-resolve-v1-manifest.json
Agents/solver-input/texas-solver/mtt-safe-flops-v1/parameters/pkrtrainer_mtt_accuracy_resolve_v1/

# The weekend uniform-tree batch is regenerated from current evidence on every
# worker start and shrinks as boards converge, so it is never a committed state.
Agents/solver-input/texas-solver/mtt-safe-flops-v1/uniform-tree-weekend-v1-manifest.json
Agents/solver-input/texas-solver/mtt-safe-flops-v1/parameters/pkrtrainer_mtt_uniform_tree_weekend_v1/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
*.local
.vscode/*
!.vscode/extensions.json
.idea/
.cache/

# Generované vstupy pro solver: vznikají z preflop packů odvozením
# (npm run mtt:seat-pair-expansion), takže je nemá cenu verzovat - při plném
# běhu jich je 522 a přegenerují se kdykoli.
Agents/solver-input/texas-solver/mtt-safe-flops-v1/parameters/pkrtrainer_mtt_seat_pair_expansion_v1/

# Bajtkód Pythonu. Byly verzované tři soubory, takže každé spuštění nočního
# skriptu zašpinilo strom - a balení vyžaduje čistý strom, takže to opakovaně
# blokovalo dodání.
__pycache__/
*.pyc
